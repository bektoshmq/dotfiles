{
  "workbench.colorTheme": "Ship at Sea",
  "window.confirmBeforeClose": "always",
  "window.commandCenter": false,
  "workbench.sideBar.location": "right",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 9,
  "workbench.layoutControl.enabled": false,
  "workbench.reduceMotion": "off",
  "workbench.list.smoothScrolling": true,
  "workbench.list.mouseWheelScrollSensitivity": 2,
  "breadcrumbs.enabled": false,
  "markdown.preview.fontSize": 18,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 18,
  "editor.fontWeight": "400",
  "editor.fontLigatures": "'calt', 'liga', 'dlig', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'zero'",
  "editor.lineNumbers": "relative",
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.mouseWheelScrollSensitivity": 2,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.stickyScroll.enabled": false,
  "editor.guides.indentation": false,
  "editor.inlayHints.enabled": "off",
  "editor.renderWhitespace": "none",
  "editor.formatOnSave": true,
  "editor.detectIndentation": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.autoSave": "off",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 2,
  "debug.console.fontFamily": "JetBrainsMono Nerd Font",
  "vim.useSystemClipboard": true,
  "vim.smartRelativeLine": true,
  "vim.leader": "<space>",
  "vim.visualstar": true,
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-f>": false,
    "<C-n>": false,
    "<C-p>": false
  },
