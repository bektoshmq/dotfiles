{
	"shell_cmd": "clang -std=c++20 -Wall \"$file\" -o \"$file_base_name\" && \"$file_base_name\"",
	"file_regex": "^(..[^:]*):([0-9]+):([0-9]+):? error: (.*)$",
	"working_dir": "$file_path",
	"selector": "source.c, source.c++",
	"variants": [
		{
			"name": "Build (no run)",
			"shell_cmd": "clang -std=c++20 -Wall \"$file\" -o \"$file_base_name\"",
		},
		{
			"name": "Build C",
			"shell_cmd": "clang -std=c2x -Wall \"$file\" -o \"$file_base_name\" && \"$file_base_name\"",
		},
	],
}
